+/*!
+* Check whether any display other than the built-in panel is connected.
+*
+* This asks RandR for the outputs it already knows about rather than
+* re-probing them: XRRGetScreenResources forces a DDC probe of every
+* connector, which is slow and is exactly the kind of traffic that should
+* not be generated from a lid event.
+*
+* An output is taken to be the built-in panel by name, which is the
+* convention every driver follows: eDP, LVDS and DSI.
+*
+* \return boolean with the result of the check
+* \retval true if at least one external display is connected
+* \retval false if only the panel is connected, or RandR is unavailable
+*/
+bool screen::externalDisplayConnected() {
+	kdDebugFuncIn(trace);
+
+	Display *dpy = tqt_xdisplay();
+	int event_base, error_base;
+
+	if (!dpy || !XRRQueryExtension(dpy, &event_base, &error_base)) {
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	/*
+	 * This is called while the display is changing, which is the one time
+	 * an output can be removed between the two calls below: the resource
+	 * list is a snapshot, and XRRGetOutputInfo on an id the server has
+	 * since dropped is an error rather than a null return. Catch it the
+	 * way the rest of this file does instead of letting it reach the
+	 * default handler.
+	 */
+	defaultHandler = XSetErrorHandler(badwindow_handler);
+
+	XRRScreenResources *res =
+		XRRGetScreenResourcesCurrent(dpy, DefaultRootWindow(dpy));
+	if (!res) {
+		XSetErrorHandler(defaultHandler);
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	bool found = false;
+	for (int i = 0; i < res->noutput && !found; i++) {
+		XRROutputInfo *out = XRRGetOutputInfo(dpy, res, res->outputs[i]);
+		if (!out) continue;
+
+		if (out->connection == RR_Connected && out->name) {
+			TQString name = TQString::fromLatin1(out->name);
+			if (!name.startsWith("eDP", false) &&
+			    !name.startsWith("LVDS", false) &&
+			    !name.startsWith("DSI", false)) {
+				kdDebug() << "external display connected: "
+					  << name << endl;
+				found = true;
+			}
+		}
+		XRRFreeOutputInfo(out);
+	}
+	XRRFreeScreenResources(res);
+	XSetErrorHandler(defaultHandler);
+
+	kdDebugFuncOut(trace);
+	return found;
+}
