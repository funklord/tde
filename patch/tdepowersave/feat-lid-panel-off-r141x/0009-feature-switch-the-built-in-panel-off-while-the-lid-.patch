+/*!
+* Run xrandr and wait for it.
+*
+* Blocking is the point rather than an oversight: the caller checks the
+* resulting configuration immediately afterwards and undoes it if no display
+* survived, and that check is meaningless against a process still running.
+* xrandr returns promptly, and this is reached only from a lid event.
+*
+* \param args the arguments to pass
+* \return boolean with the result of the operation
+* \retval true if xrandr ran and exited zero
+* \retval false if it could not be started, or exited non-zero
+*/
+bool screen::runXrandr( const TQStringList &args ) {
+	TDEProcess proc;
+	proc << "xrandr" << args;
+
+	if (!proc.start(TDEProcess::Block)) {
+		kdWarning() << "tdepowersave: could not run xrandr; leaving the "
+			    << "display configuration alone." << endl;
+		return false;
+	}
+
+	if (!proc.normalExit() || proc.exitStatus() != 0) {
+		kdWarning() << "tdepowersave: xrandr failed" << endl;
+		return false;
+	}
+
+	return true;
+}
+
+/*!
+* Name the built-in panel's RandR output.
+*
+* The kernel names DRM connectors <type>-<index> from a fixed table, so eDP,
+* LVDS and DSI are the connector type rather than a guess, and the modesetting,
+* intel and amdgpu drivers pass those names through to RandR. Drivers that do
+* not -- the proprietary NVIDIA one spells them DFP-0 -- match nothing here,
+* and that is the correct outcome: an unrecognised panel means no action.
+*
+* Refuses when more than one internal output exists. A dual-panel laptop has
+* two eDPs and only one of them is behind the lid; nothing visible from here
+* says which, and switching off the wrong one is a fault the user watches
+* happen.
+*
+* \param name set to the output's name when exactly one is found
+* \return boolean with the result of the search
+* \retval true if exactly one internal output was identified
+* \retval false if none, or more than one, or RandR is unavailable
+*/
+bool screen::internalPanelOutput( TQString &name ) {
+	kdDebugFuncIn(trace);
+
+	Display *dpy = tqt_xdisplay();
+	int event_base, error_base;
+
+	if (!dpy || !XRRQueryExtension(dpy, &event_base, &error_base)) {
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	defaultHandler = XSetErrorHandler(badwindow_handler);
+
+	XRRScreenResources *res =
+		XRRGetScreenResourcesCurrent(dpy, DefaultRootWindow(dpy));
+	if (!res) {
+		XSetErrorHandler(defaultHandler);
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	int found = 0;
+	TQString candidate;
+
+	for (int i = 0; i < res->noutput; i++) {
+		XRROutputInfo *out = XRRGetOutputInfo(dpy, res, res->outputs[i]);
+		if (!out) continue;
+
+		if (out->connection == RR_Connected && out->name) {
+			TQString n = TQString::fromLatin1(out->name);
+			if (n.startsWith("eDP", false) ||
+			    n.startsWith("LVDS", false) ||
+			    n.startsWith("DSI", false)) {
+				found++;
+				candidate = n;
+			}
+		}
+		XRRFreeOutputInfo(out);
+	}
+	XRRFreeScreenResources(res);
+	XSetErrorHandler(defaultHandler);
+
+	if (found != 1) {
+		if (found > 1) {
+			kdWarning() << "tdepowersave: " << found << " built-in panels "
+				    << "found; refusing to guess which is behind the lid."
+				    << endl;
+		}
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	name = candidate;
+	kdDebugFuncOut(trace);
+	return true;
+}
+
+/*!
+* Count the outputs that currently have a CRTC driving them.
+*
+* This is what decides whether the panel may be switched off, and it is
+* deliberately not the same question as whether an external display is
+* connected: a connector can be connected and dark, and asking about
+* connectedness leaves a race in which the external vanishes between the
+* check and the act.
+*
+* \return the number of outputs with a CRTC, or 0 if RandR is unavailable
+*/
+int screen::enabledOutputCount() {
+	kdDebugFuncIn(trace);
+
+	Display *dpy = tqt_xdisplay();
+	int event_base, error_base;
+
+	if (!dpy || !XRRQueryExtension(dpy, &event_base, &error_base)) {
+		kdDebugFuncOut(trace);
+		return 0;
+	}
+
+	defaultHandler = XSetErrorHandler(badwindow_handler);
+
+	XRRScreenResources *res =
+		XRRGetScreenResourcesCurrent(dpy, DefaultRootWindow(dpy));
+	if (!res) {
+		XSetErrorHandler(defaultHandler);
+		kdDebugFuncOut(trace);
+		return 0;
+	}
+
+	int enabled = 0;
+	for (int i = 0; i < res->noutput; i++) {
+		XRROutputInfo *out = XRRGetOutputInfo(dpy, res, res->outputs[i]);
+		if (!out) continue;
+		if (out->crtc != None) enabled++;
+		XRRFreeOutputInfo(out);
+	}
+	XRRFreeScreenResources(res);
+	XSetErrorHandler(defaultHandler);
+
+	kdDebugFuncOut(trace);
+	return enabled;
+}
+
+/*!
+* Is a built-in panel connected but not being driven?
+*
+* \return boolean with the result of the check
+* \retval true if exactly one internal output exists and has no CRTC
+* \retval false otherwise, including when RandR is unavailable
+*/
+bool screen::internalPanelIsOff() {
+	TQString name;
+	if (!internalPanelOutput(name)) return false;
+
+	Display *dpy = tqt_xdisplay();
+	defaultHandler = XSetErrorHandler(badwindow_handler);
+
+	XRRScreenResources *res =
+		XRRGetScreenResourcesCurrent(dpy, DefaultRootWindow(dpy));
+	if (!res) {
+		XSetErrorHandler(defaultHandler);
+		return false;
+	}
+
+	bool off = false;
+	for (int i = 0; i < res->noutput; i++) {
+		XRROutputInfo *out = XRRGetOutputInfo(dpy, res, res->outputs[i]);
+		if (!out) continue;
+		if (out->name && name == TQString::fromLatin1(out->name)) {
+			off = (out->crtc == None);
+		}
+		XRRFreeOutputInfo(out);
+	}
+	XRRFreeScreenResources(res);
+	XSetErrorHandler(defaultHandler);
+
+	return off;
+}
+
+/*!
+* Bring back a panel that was switched off by a process which is no longer
+* running.
+*
+* Nothing here recorded that configuration, so the panel comes back at its
+* preferred mode rather than exactly as it was. That is the right trade: the
+* alternative to an approximate restoration is none at all, and the case this
+* exists for is a machine whose lid is open and whose screen is dark.
+*
+* The caller gates this on the setting, so a panel somebody switched off
+* deliberately is left alone unless they asked for this behaviour.
+*
+* \return boolean with the result of the operation
+* \retval true if a panel was brought back
+* \retval false if there was nothing to do
+*/
+bool screen::healInternalPanel() {
+	kdDebugFuncIn(trace);
+
+	TQString name;
+	if (!internalPanelOutput(name) || !internalPanelIsOff()) {
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	kdWarning() << "tdepowersave: " << name << " was left switched off; "
+		    << "bringing it back at its preferred mode." << endl;
+	if (!runXrandr(TQStringList() << "--output" << name << "--auto")) {
+		kdError() << "tdepowersave: could not bring " << name << " back. "
+			  << "Recover with: xrandr --output " << name << " --auto"
+			  << endl;
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	m_panelDisabled = false;
+	kdDebugFuncOut(trace);
+	return true;
+}
+
+/*!
+* Record the built-in panel's configuration and switch its output off.
+*
+* Reading is done through RandR, which reports the mode, position and primary
+* flag exactly; writing is left to xrandr, which recomputes the framebuffer
+* size. Doing the write here as well would mean reimplementing that
+* arithmetic, and getting it wrong corrupts the screen rather than merely
+* failing.
+*
+* Refuses unless another output is already being driven, so the last one can
+* never be switched off, and checks again afterwards: if nothing survived, the
+* panel is put straight back. That is the difference between a bug and a
+* machine that displays nothing.
+*
+* \return boolean with the result of the operation
+* \retval true if the panel was switched off
+* \retval false if it was refused, or failed and was rolled back
+*/
+bool screen::disableInternalPanel() {
+	kdDebugFuncIn(trace);
+
+	if (m_panelDisabled) {
+		kdDebugFuncOut(trace);
+		return true;
+	}
+
+	TQString name;
+	if (!internalPanelOutput(name)) {
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	if (enabledOutputCount() < 2) {
+		kdDebug() << "tdepowersave: " << name << " is the only display in "
+			  << "use; not switching it off." << endl;
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	/* Record what it is now, so restoring puts back this and not a guess. */
+	Display *dpy = tqt_xdisplay();
+	defaultHandler = XSetErrorHandler(badwindow_handler);
+
+	XRRScreenResources *res =
+		XRRGetScreenResourcesCurrent(dpy, DefaultRootWindow(dpy));
+	if (!res) {
+		XSetErrorHandler(defaultHandler);
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	RROutput primary = XRRGetOutputPrimary(dpy, DefaultRootWindow(dpy));
+	bool recorded = false;
+
+	for (int i = 0; i < res->noutput && !recorded; i++) {
+		XRROutputInfo *out = XRRGetOutputInfo(dpy, res, res->outputs[i]);
+		if (!out) continue;
+
+		if (out->name && name == TQString::fromLatin1(out->name) &&
+		    out->crtc != None) {
+			XRRCrtcInfo *crtc = XRRGetCrtcInfo(dpy, res, out->crtc);
+			if (crtc) {
+				m_panelX = crtc->x;
+				m_panelY = crtc->y;
+				for (int m = 0; m < res->nmode; m++) {
+					if (res->modes[m].id == crtc->mode) {
+						m_panelWidth = res->modes[m].width;
+						m_panelHeight = res->modes[m].height;
+						recorded = true;
+						break;
+					}
+				}
+				XRRFreeCrtcInfo(crtc);
+			}
+			m_panelPrimary = (res->outputs[i] == primary);
+		}
+		XRRFreeOutputInfo(out);
+	}
+	XRRFreeScreenResources(res);
+	XSetErrorHandler(defaultHandler);
+
+	if (!recorded) {
+		kdWarning() << "tdepowersave: could not read " << name << "'s current "
+			    << "mode; not switching it off, since it could not be put "
+			    << "back." << endl;
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	m_panelName = name;
+	if (!runXrandr(TQStringList() << "--output" << name << "--off")) {
+		/*
+		 * xrandr could not be run, or refused. Nothing has changed, and the
+		 * panel must not be recorded as switched off: doing so would have
+		 * the lid-open path reconfigure a panel nothing ever touched.
+		 */
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	/* Verify. If nothing is being driven now, undo it immediately. */
+	if (enabledOutputCount() < 1) {
+		kdWarning() << "tdepowersave: switching off " << name << " left no "
+			    << "display in use; putting it back." << endl;
+		if (!runXrandr(TQStringList() << "--output" << name
+			  << "--mode" << TQString("%1x%2").arg(m_panelWidth)
+						          .arg(m_panelHeight)
+			  << "--pos" << TQString("%1x%2").arg(m_panelX)
+							 .arg(m_panelY))) {
+			kdError() << "tdepowersave: could not put " << name << " back "
+				  << "after switching it off left nothing displaying. "
+				  << "Recover with: xrandr --output " << name
+				  << " --auto" << endl;
+		}
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	/*
+	 * xrandr exiting zero is not by itself evidence that it did anything,
+	 * so confirm the panel actually went dark before recording it as off.
+	 */
+	if (!internalPanelIsOff()) {
+		kdWarning() << "tdepowersave: xrandr reported success but " << name
+			    << " is still being driven; not recording it as switched "
+			    << "off." << endl;
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	m_panelDisabled = true;
+	kdDebug() << "tdepowersave: switched off " << name << endl;
+	kdDebugFuncOut(trace);
+	return true;
+}
+
+/*!
+* Put the built-in panel back exactly as it was recorded.
+*
+* Called unconditionally on lid open, and at startup when the lid is open and
+* a panel is found switched off. It does not consult whether this process is
+* the one that switched it off, because the case that matters is the one where
+* the process that did so is no longer running.
+*
+* \return boolean with the result of the operation
+* \retval true if a panel was restored
+* \retval false if there was nothing to do
+*/
+bool screen::restoreInternalPanel() {
+	kdDebugFuncIn(trace);
+
+	if (!m_panelDisabled || m_panelName.isEmpty()) {
+		kdDebugFuncOut(trace);
+		return false;
+	}
+
+	TQStringList args;
+	args << "--output" << m_panelName
+	     << "--mode" << TQString("%1x%2").arg(m_panelWidth).arg(m_panelHeight)
+	     << "--pos"  << TQString("%1x%2").arg(m_panelX).arg(m_panelY);
+	if (m_panelPrimary) args << "--primary";
+
+	if (!runXrandr(args)) {
+		/*
+		 * Leave m_panelDisabled set. The panel is still off, and saying
+		 * otherwise would stop the next lid-open and the startup check from
+		 * trying again, which are the only things that will.
+		 */
+		kdError() << "tdepowersave: could not restore " << m_panelName
+			  << ". Recover with: xrandr --output " << m_panelName
+			  << " --auto" << endl;
+		kdDebugFuncOut(trace);
+		return false;
+	}
+	m_panelDisabled = false;
+
+	kdDebug() << "tdepowersave: restored " << m_panelName << endl;
+	kdDebugFuncOut(trace);
+	return true;
+}
+
