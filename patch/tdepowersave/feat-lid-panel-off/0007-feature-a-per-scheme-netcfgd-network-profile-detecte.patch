 		notifySchemeSwitch();
  	} else if (!settings->schemes[i]){
 		KPassivePopup::message( i18n("WARNING"),
@@ -1855,6 +1856,31 @@ void tdepowersave::showErrorMessage( TQString msg ){
  * e.g. the screensaver and dpms settings. Don't forget to call this function if
  * a scheme is changed or if the settings changed.
  */
+/*!
+ * Switch the netcfgd profile this scheme names, if any, through `ncfg`.
+ *
+ * Silent by design: schemes flip on every AC/battery transition, so a popup
+ * each time would be noise. A failure is remembered and shown as text in the
+ * configure dialog instead. Does nothing, and is not an error, when the
+ * scheme names no profile or `ncfg` is not installed.
+ */
+void tdepowersave::applyNetworkProfile(){
+	if (settings->networkProfile.isEmpty()) {
+		settings->lastNetworkProfileError = TQString::null;
+		return;
+	}
+	if (!Settings::ncfgAvailable())
+		return;
+
+	TQString err;
+	if (Settings::ncfgProfileSet(settings->networkProfile, err))
+		settings->lastNetworkProfileError = TQString::null;
+	else {
+		settings->lastNetworkProfileError = err;
+		kdWarning() << "tdepowersave: " << err << endl;
+	}
+}
