+/*!
+* Is the netcfgd command-line tool installed?
+*
+* Detection only, no linking: everything netcfgd here goes through `ncfg`.
+*/
+bool Settings::ncfgAvailable() {
+	return !TDEGlobal::dirs()->findExe("ncfg").isEmpty();
+}
+
+/*!
+* The netcfgd profile names, from `ncfg profile list`.
+*
+* Each line is a name followed by an annotation, e.g. "offline  (shipped)";
+* the name is the first field. No user input goes into this command, so
+* reading it through a captured pipe is safe -- and a static helper has
+* nowhere to hang the signal a TDEProcess capture would need.
+*/
+TQStringList Settings::ncfgProfileList() {
+	TQStringList names;
+	FILE *pipe = popen("ncfg profile list 2>/dev/null", "r");
+	if (!pipe) return names;
+	char line[512];
+	while (fgets(line, sizeof(line), pipe)) {
+		TQString name = TQString::fromLocal8Bit(line).simplifyWhiteSpace()
+		                                             .section(' ', 0, 0);
+		if (!name.isEmpty()) names.append(name);
+	}
+	pclose(pipe);
+	return names;
+}
+
+/*!
+* Switch netcfgd to a named profile.
+*
+* No shell: the name comes from configuration and must not be interpreted,
+* so TDEProcess passes it as an argument rather than a command line. The
+* switch reconfigures the network as soon as it is written; this is called
+* only from a scheme change the operator set up, and reports failure as text
+* rather than acting on the machine any further.
+*/
+bool Settings::ncfgProfileSet( const TQString &name, TQString &err ) {
+	TDEProcess proc;
+	proc << "ncfg" << "profile" << "set" << name;
+	if (!proc.start(TDEProcess::Block)) {
+		err = i18n("Could not run ncfg to switch the network profile.");
+		return false;
+	}
+	if (!proc.normalExit() || proc.exitStatus() != 0) {
+		err = i18n("Could not switch to network profile \"%1\". Run "
+		           "`ncfg profile set %1` in a terminal to see why.").arg(name);
+		return false;
+	}
+	err = TQString::null;
+	return true;
+}
