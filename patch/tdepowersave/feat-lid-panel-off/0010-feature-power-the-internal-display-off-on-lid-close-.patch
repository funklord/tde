+/*!
+ * \b Power-save the internal panel on lid close.
+ *
+ * Turning the display off is treated as its own concern, separate from
+ * locking and from suspending: a shut lid is never being looked at, so the
+ * caller runs this in every mode, inhibit included. The mechanism depends on
+ * \ref Settings::lidDisplayLightOnly and on whether an external display is
+ * present, and each choice records what it did so the lid-open path can undo
+ * exactly that:
+ *
+ *  \li lidDisplayLightOnly: dim the backlight to nothing and change no
+ *      display configuration or power state. This is the safe path for
+ *      setups that cannot survive an output being reconfigured or a transient
+ *      zero-display state. The current level is saved for restore on open.
+ *  \li docked (an external display is driving): disable the internal output
+ *      entirely -- light and drive both off, the external untouched.
+ *      disableInternalPanel() refuses if that would leave nothing displaying.
+ *  \li alone (the internal panel is the only display): force DPMS off. That
+ *      is a power state rather than a configuration change, so it avoids a
+ *      zero-display state and restores on the next input event. xset DPMS is
+ *      global, which is exactly why it is used only when there is no external
+ *      display for it to blank.
+ */
+void tdepowersave::powerSaveInternalDisplay(){
+	kdDebugFuncIn(trace);
+
+	if (settings->lidDisplayLightOnly) {
+		if (hwinfo->supportBrightness()) {
+			int level = hwinfo->getCurrentBrightnessLevel();
+			if (level > 0) {
+				m_savedLidBrightnessLevel = level;
+				hwinfo->setBrightnessLevel(0);
+			}
+		}
+		else {
+			kdWarning() << "lidDisplayLightOnly is set but the machine cannot "
+				    << "control brightness; leaving the display alone" << endl;
+		}
+		kdDebugFuncOut(trace);
+		return;
+	}
+
+	if (display->externalDisplayConnected()) {
+		display->disableInternalPanel();
+	}
+	else {
+		display->forceDPMSOff();
+		m_lidForcedDpms = true;
+	}
+
+	kdDebugFuncOut(trace);
+}
