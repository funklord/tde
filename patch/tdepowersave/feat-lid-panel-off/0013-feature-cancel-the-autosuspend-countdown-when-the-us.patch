+/*!
+ * Start polling for the user becoming active again, after an inactivity
+ * action has fired. The caller connects to \ref UserIsActiveAgain() to undo
+ * whatever it did -- brighten the display, or cancel a pending autosuspend.
+ */
+void inactivity::startCheckForActivity() {
+	kdDebugFuncIn(trace);
+
+	lastIdleTime = 0;
+
+	if (checkActivity->isActive())
+		checkActivity->stop();
+
+	checkActivity->start(RECHECK_INTERVALL, false);
+
+	kdDebugFuncOut(trace);
+}
+
+/*!
+ * \b Slot polled while \ref checkActivity runs: read the X idle time and, when
+ * it drops below the previous reading, take that as the user having returned
+ * and emit \ref UserIsActiveAgain(). The timer stops itself first, so the
+ * signal fires once per activity spell.
+ */
+void inactivity::pollActivity() {
+	kdDebugFuncIn(trace);
+
+	unsigned long idletime = getXInactivity();
+	if (idletime < lastIdleTime) {
+		kdDebug() << "Looks as if the user is active again (lastIdleTime:"
+			  << lastIdleTime << ", current idletime: " << idletime << ")"
+			  << endl;
+
+		if (checkActivity->isActive())
+			checkActivity->stop();
+		emit UserIsActiveAgain();
+	} else {
+		lastIdleTime = idletime;
+	}
+
+	kdDebugFuncOut(trace);
+}
