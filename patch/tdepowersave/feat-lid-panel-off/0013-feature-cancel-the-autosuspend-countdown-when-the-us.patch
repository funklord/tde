+	countdown = 0;
+
 	if (!cancel) {
 		if(!settings->disableNotifications) {
 			KNotifyClient::event( this->winId(), "autosuspend_event",
@@ -1091,6 +1102,25 @@ bool tdepowersave::do_autosuspend(bool cancel) {
 	}
 }
 
+/*!
+ * \b Slot called when the user becomes active again while the autosuspend
+ * countdown is showing. Closing the dialog (it is WDestructiveClose) makes it
+ * emit dialogClosed(true), since time remains, which routes to
+ * do_autosuspend(true) -- so the suspend is cancelled and inactivity
+ * monitoring restarts, exactly as the Cancel button does.
+ */
+void tdepowersave::do_cancelAutosuspendOnActivity() {
+	kdDebugFuncIn(trace);
+
+	if (countdown) {
+		kdDebug() << "User active again during the autosuspend countdown; "
+			  << "cancelling it" << endl;
+		countdown->close();
+	}
+
+	kdDebugFuncOut(trace);
+}
