 }
 
+// A monitor mirrors the primary one when it is active and placed at the
+// primary monitor's position. Nothing else marks a mirror, so a profile
+// needs no new field, and an arrangement mirrored outside TDE is shown as
+// a mirror rather than pulled apart by the layout rules.
+bool KDisplayConfig::isMirrorOfPrimary (int screen_id) {
+	int i;
+	SingleScreenData *screendata = m_screenInfoArray[activeProfileName].at(screen_id);
+	SingleScreenData *primarydata = NULL;
+
+	for (i=0;i<numberOfScreens;i++) {
+		if (m_screenInfoArray[activeProfileName].at(i)->is_primary) {
+			primarydata = m_screenInfoArray[activeProfileName].at(i);
+		}
+	}
+	if (!screendata || !primarydata || (screendata == primarydata) || !screendata->is_extended) {
+		return false;
+	}
+	return ((screendata->absolute_x_position == primarydata->absolute_x_position)
+		&& (screendata->absolute_y_position == primarydata->absolute_y_position));
+}
+
+void KDisplayConfig::updateMirrorMonitorInformation () {
+	int i;
+	SingleScreenData *screendata;
+	SingleScreenData *primarydata = NULL;
+
+	screendata = m_screenInfoArray[activeProfileName].at(base->monitorDisplaySelectDD->currentItem());
+	for (i=0;i<numberOfScreens;i++) {
+		if (m_screenInfoArray[activeProfileName].at(i)->is_primary) {
+			primarydata = m_screenInfoArray[activeProfileName].at(i);
+		}
+	}
+	if (!screendata || !primarydata || (screendata == primarydata)) {
+		return;
+	}
+
+	if (base->isMirrorMonitorCB->isChecked()) {
+		// Show the top left of the primary monitor's image: at the same
+		// position, each monitor keeps its own resolution
+		screendata->absolute_x_position = primarydata->absolute_x_position;
+		screendata->absolute_y_position = primarydata->absolute_y_position;
+	}
+	else {
+		// Place it to the right of the primary monitor, where the layout
+		// rules then keep it
+		bool isvisiblyrotated = (primarydata->current_rotation_index == ROTATION_90_DEGREES_INDEX) || (primarydata->current_rotation_index == ROTATION_270_DEGREES_INDEX);
+		screendata->absolute_x_position = primarydata->absolute_x_position + (isvisiblyrotated ? primarydata->current_y_pixel_count : primarydata->current_x_pixel_count);
+		screendata->absolute_y_position = primarydata->absolute_y_position;
+	}
+
+	refreshDisplayedInformation();
+}
+
 void KDisplayConfig::rescanHardware (void) {
 	m_randrsimple->destroyScreenInformationObject(m_screenInfoArray[activeProfileName]);
 	m_hardwareScreenInfoArray = m_randrsimple->readCurrentDisplayConfiguration();
@@ -1186,6 +1247,7 @@ void KDisplayConfig::updateDisplayedInformation () {
 		base->orientationVFlip->setEnabled(false);
 		base->isPrimaryMonitorCB->setEnabled(false);
 		base->isExtendedMonitorCB->setEnabled(false);
+		base->isMirrorMonitorCB->setEnabled(false);
 		return;
 	}
 
@@ -1263,6 +1325,13 @@ void KDisplayConfig::updateDisplayedInformation () {
 	base->isPrimaryMonitorCB->blockSignals(false);
 	base->isExtendedMonitorCB->blockSignals(false);
 
+	// Only a monitor that shows part of the desktop, and is not the
+	// primary one, can mirror the primary
+	base->isMirrorMonitorCB->blockSignals(true);
+	base->isMirrorMonitorCB->setEnabled(!screendata->generic_screen_detected && !screendata->is_primary && screendata->is_extended);
+	base->isMirrorMonitorCB->setChecked(isMirrorOfPrimary(base->monitorDisplaySelectDD->currentItem()));
+	base->isMirrorMonitorCB->blockSignals(false);
+
 	if (!screendata->screen_connected) {
 		base->resolutionSlider->setEnabled(false);
 		base->refreshRateDD->setEnabled(false);
@@ -1271,6 +1340,7 @@ void KDisplayConfig::updateDisplayedInformation () {
 		base->orientationVFlip->setEnabled(false);
 		base->isPrimaryMonitorCB->setEnabled(false);
 		base->isExtendedMonitorCB->setEnabled(false);
+		base->isMirrorMonitorCB->setEnabled(false);
 	}
 }
 
