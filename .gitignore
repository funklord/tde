# Upstream TDE clones. These are somebody else's repositories, fetched with
# `make upstream`; they carry their own history and are never committed here.
/tdebase/
/tdepowersave/

# Build output and staging prefixes. Never installed over /opt/trinity.
/build/
/stage/

# Generated and built by test/dbus-signal-delivery/Makefile.
/test/dbus-signal-delivery/probe
/test/dbus-signal-delivery/moc_probe.cpp
/test/dbus-signal-delivery/control.log

# Session scratch: logs and harness output. Never committed.
/scratch/

# Written by python running tool/style_gate.py and its suite. Every other
# private project ignores it; tde had no rule because until 2026-09-15 it
# was not on the list and carried the gate by hand.
__pycache__/

# Built by test/docked-detect/Makefile.
/test/docked-detect/probe
/test/docked-detect/cc.log
